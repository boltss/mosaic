{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "unicorn", "oxc", "import"],
  "jsPlugins": [{ "name": "naming", "specifier": "eslint-plugin-unicorn" }],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "es2024": true },
  "globals": { "chrome": "readonly", "Bun": "readonly" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/memo-dependencies": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/preserve-manual-memoization": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-underscore-dangle": "off",
    "id-length": ["error", { "min": 2, "properties": "never" }],
    "naming/name-replacements": [
      "error",
      {
        "checkFilenames": false,
        "allowList": { "props": true, "Props": true, "ref": true, "Ref": true },
        "replacements": {
          "msg": { "message": true },
          "md": { "markdown": true },
          "fm": { "frontMatter": true },
          "pr": { "pullRequest": true },
          "prs": { "pullRequests": true },
          "repo": { "repository": true },
          "sec": { "seconds": true, "section": true },
          "secs": { "seconds": true },
          "ms": { "milliseconds": true },
          "min": { "minimum": true, "minutes": true },
          "max": { "maximum": true },
          "del": { "deletion": true, "deletions": true },
          "ctx": { "context": true },
          "kv": { "keyValueStore": true, "store": true },
          "bg": { "background": true },
          "fg": { "foreground": true },
          "cls": { "className": true },
          "seg": { "segment": true },
          "segs": { "segments": true },
          "sig": { "signature": true },
          "sigs": { "signatures": true },
          "cnt": { "count": true },
          "lbl": { "label": true },
          "nm": { "name": true },
          "fmt": { "format": true },
          "est": { "estimate": true },
          "info": false,
          "oid": { "commitId": true },
          "img": { "image": true },
          "btn": { "button": true },
          "cfg": { "configuration": true },
          "ok": false,
          "rec": { "record": true },
          "spec": false,
          "specs": false,
          "tok": { "token": true },
          "exe": { "executablePath": true },
          "mk": { "marker": true },
          "ro": { "resizeObserver": true },
          "sv": { "saved": true },
          "dev": false,
          "env": false
        }
      }
    ]
  },
  "ignorePatterns": ["dist", "dist-dev", "spike", "node_modules", ".e2e-profile"]
}
